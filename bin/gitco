#!/usr/bin/env bash
#
# gitco: check out a local branch by search term.
#   gitco 123   one match -> check it out; several -> pick from a menu

search=$1
if [[ -z "$search" ]]; then
  echo "usage: gitco <search>" >&2
  exit 1
fi

# --format prints bare names (no "*" current-branch marker to glob-expand),
# one per line; read them into an array, skipping the current branch.
current=$(git branch --show-current)
branches=()
while IFS= read -r b; do
  [[ "$b" != "$current" ]] && branches+=("$b")
done < <(git branch --list --format='%(refname:short)' "*${search}*")

case ${#branches[@]} in
  0) echo "No other branches matching '$search'."; exit 0 ;;
  1) echo "Found 1 branch matching '$search'."; exec git checkout "${branches[0]}" ;;
esac

# `select` numbers the options and re-prompts on invalid input.
echo "Found ${#branches[@]} branches matching '$search':"
PS3="Choose a number: "
select b in "${branches[@]}" "(cancel)"; do
  [[ "$b" == "(cancel)" ]] && { echo "Nevermind."; exit 0; }
  [[ -n "$b" ]] && exec git checkout "$b"
done
