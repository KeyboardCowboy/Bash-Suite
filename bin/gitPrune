#!/usr/bin/env bash
#
# gitPrune: refresh REMOTE, then offer to delete each local branch that is
# already merged into the current branch.
#   gitPrune origin

source ~/.bash_config/global/colors.bash
source ~/.bash_config/global/func/tools.bash

remote=$1
if [[ -z "$remote" ]]; then
  print_error "You need to provide a remote to check against."
  exit 1
fi

# Update with pruned references to the remote.
git fetch "$remote" --prune || exit 1

# Collect the list FIRST, so the prompts below read the keyboard, not git.
current=$(git branch --show-current)
branches=()
while IFS= read -r b; do
  branches+=("$b")
done < <(git branch --list --format='%(refname:short)' --merged)

print_message "Branches merged into ${current:-HEAD}. Delete local branch?"
for branch in "${branches[@]}"; do
  # Never offer protected branches or the one we're on.
  case "$branch" in
    main|master|dev|develop|"$current") continue ;;
  esac

  action=''
  while [[ "$action" != y && "$action" != n ]]; do
    read -r -p "$branch [y/n]: " action || exit 1
  done
  # -d (not -D): git refuses if the branch turns out not to be merged.
  if [[ "$action" == y ]]; then
    git branch -d "$branch"
  fi
done
