#!/usr/bin/env bash
#
# gitTrim: walk every local branch and choose to delete it locally,
# locally + on origin, skip it, or exit.

source ~/.bash_config/global/colors.bash
source ~/.bash_config/global/func/git.bash

if [[ -z "$(is_git)" ]]; then
  echo "Not in a git repository." >&2
  exit 1
fi

# Collect the list FIRST, so the prompts below read the keyboard, not git.
current=$(git branch --show-current)
branches=()
while IFS= read -r b; do
  branches+=("$b")
done < <(git for-each-ref --format='%(refname:short)' refs/heads/)

echo "Which do you want to delete?"
for branch in "${branches[@]}"; do
  # Never offer protected branches or the one we're on.
  case "$branch" in
    main|master|dev|develop|"$current") continue ;;
  esac

  prompt="${YELLOW}${branch}${RESET}: ${CYAN}(l)${RESET}ocal, ${CYAN}(o)${RESET}rigin, ${CYAN}(s)${RESET}kip, ${CYAN}(e)${RESET}xit: "
  action=''
  while [[ ! "$action" =~ ^[lose]$ ]]; do
    read -r -p "$prompt" action || exit 1
  done

  case $action in
    l) git branch -D "$branch" ;;
    # Only drop the local copy if the remote delete succeeded.
    o) git push origin --delete "$branch" && git branch -D "$branch" ;;
    s) echo "skipped..." ;;
    e) echo "exiting..."; exit 0 ;;
  esac
done
