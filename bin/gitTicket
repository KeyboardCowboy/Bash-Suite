#!/usr/bin/env bash
#
# gitTicket: pull, then create a branch named <initials>-<ticket>-<desc> and
# record the ticket in the branch description.
#   gitTicket 123 fix-login   ->  xx-123-fix-login   (xx = git config user.initials)

num=$1
desc=$2
if [[ -z "$num" || -z "$desc" ]]; then
  echo "usage: gitTicket <ticket-number> <short-description>" >&2
  exit 1
fi

if ! initials=$(git config user.initials); then
  echo "Set your initials first: git config --global user.initials xx" >&2
  exit 1
fi
branch="${initials}-${num}-${desc}"

# Start from the latest code; stop if the pull fails.
git pull || exit 1
git checkout -b "$branch" || exit 1

# Add the ticket tracking description, then show it.
git config "branch.${branch}.description" "Branch for ticket [#${num}]"
git config "branch.${branch}.description"
